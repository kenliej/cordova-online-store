# ---------------------------------------------------------------------------
# Laravel backend environment for cPanel, frontend on Vercel (token auth).
#
# Copy to:  /home/CPANEL_USER/omc-backend/.env
# (the Laravel project directory, NOT public_html)
#
# Then, in the Laravel project directory:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache
# ---------------------------------------------------------------------------

APP_NAME="Online Mall Cordova"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://kjugarap.top/omc-backend
# Password-reset e-mails link to: APP_FRONTEND_URL/reset-password/<token>
# Use the exact public SPA origin (Vercel URL, no trailing slash).
APP_FRONTEND_URL=https://YOUR-PROJECT.vercel.app
APP_TIMEZONE=Asia/Manila
APP_FORCE_HTTPS=true

# Comma-separated Host allow-list; blocks Host-header (reset-link) poisoning.
TRUSTED_HOSTS=kjugarap.top
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- PostgreSQL -----------------------------------------------------------
# cPanel: create the database/user in "PostgreSQL Databases" (only available
# when your host enables PostgreSQL). If your cPanel plan has no PostgreSQL,
# use a managed instance (Neon, Supabase, RDS, ...) and set its host/port here
# with DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cpaneluser_omc
DB_USERNAME=cpaneluser_omc
DB_PASSWORD=
DB_SSLMODE=prefer

# --- Session/cache/queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Cookie auth stateful domains — the API host only. The Vercel frontend uses
# Bearer tokens, so it must NOT be listed here.
SANCTUM_STATEFUL_DOMAINS=kjugarap.top
# Bearer token lifetime in minutes (60*24*7 = 7 days). Empty = never expires.
SANCTUM_EXPIRATION=10080

# --- CORS (frontend origin on Vercel) -------------------------------------
CORS_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# Optional PCRE patterns for Vercel preview URLs (must include delimiters,
# must not contain commas), e.g. /^https:\/\/.*\.vercel\.app$/
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=3600

# --- Mail (cPanel mailbox / SMTP) ----------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.kjugarap.top
MAIL_PORT=587
MAIL_USERNAME=no-reply@kjugarap.top
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@kjugarap.top"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
