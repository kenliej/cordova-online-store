# ---------------------------------------------------------------------------
# cPanel / shared-hosting deployment of the Laravel API at
#   https://kjugarap.top/omc-backend
#
# Place this file in public_html/omc-backend/ next to the index.php shim.
# Replace /omc-backend/ with the subdirectory you actually use.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /omc-backend/

    # Some cPanel PHP-FPM/CGI configurations strip the Authorization header.
    # Without this, Bearer-token authentication returns 401 for every request.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve real files/directories as-is (none are expected here, but keep it safe).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is handled by Laravel.
    RewriteRule ^ index.php [L]
</IfModule>

# Optional: set a custom app path if the Laravel project is not at
# /home/CPANEL_USER/omc-backend (see index.php).
# SetEnv OMC_APP_PUBLIC_INDEX /home/CPANEL_USER/omc-backend/public/index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
DirectoryIndex index.php

# Never serve dotfiles (protects a stray .env).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Do not expose backup/archive/source files.
<FilesMatch "\.(?:env|sql|log|bak|old|zip|tar|gz|map)$">
    Require all denied
</FilesMatch>
