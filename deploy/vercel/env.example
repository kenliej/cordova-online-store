# Vercel project environment variables (Settings → Environment Variables).
# Add these for Production, Preview and Development, then redeploy.

# Absolute URL of the Laravel API, including the cPanel subdirectory.
VITE_API_BASE_URL=https://kjugarap.top/omc-backend/api

# Bearer-token auth: required because the API is on a different origin than the
# Vercel frontend (cross-site session cookies are blocked by modern browsers).
VITE_AUTH_MODE=token
