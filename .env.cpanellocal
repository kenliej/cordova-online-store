# Frontend build profile: LOCAL simulation of the split deployment.
# Used by the local E2E harness (scripts/test-e2e.ps1) and you can use it
# manually to test the frontend against the local cPanel-style backend:
#
#   1. php -S 127.0.0.1:8092 -t backend/public scripts/cpanel-subdir-sim.php   (with cPanel-like env)
#   2. npm run build:local-split
#   3. node scripts/serve-static.mjs 8091 dist-e2e-split
#   4. open http://127.0.0.1:8091
VITE_API_BASE_URL=http://127.0.0.1:8092/omc-backend/api
VITE_AUTH_MODE=token
