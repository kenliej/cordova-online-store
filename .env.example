# ---------------------------------------------------------------------------
# Docker Compose environment for the Online Mall Cordova stack.
# Copy to `.env` and fill in the required secrets:
#   cp .env.example .env
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"   # APP_KEY
# Never commit the resulting .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8080
APP_KEY=
APP_TIMEZONE=Asia/Manila
APP_FORCE_HTTPS=false
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
DB_DATABASE=online_mall
DB_USERNAME=onlinemall
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Security / sessions ---------------------------------------------------
# Set to true only when the app is served over HTTPS.
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Mail ------------------------------------------------------------------
MAIL_FROM_ADDRESS=no-reply@onlinemall.test
MAIL_FROM_NAME="Online Mall Cordova"

# --- Published ports -------------------------------------------------------
WEB_PORT=8080
MAILPIT_UI_PORT=8025
