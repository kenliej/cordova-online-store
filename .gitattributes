# Normalize line endings so Docker/Linux tooling never receives CRLF scripts
# from a Windows checkout (a CRLF entrypoint.sh breaks the shebang in Alpine).
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.php text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
