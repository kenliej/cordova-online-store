<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration for running the suite against PostgreSQL.

    The database is supplied by the environment (same variables Laravel uses):
      DB_CONNECTION=pgsql DB_HOST=127.0.0.1 DB_PORT=5432
      DB_DATABASE=online_mall_test DB_USERNAME=... DB_PASSWORD=...

    Usage:
      vendor/bin/phpunit -c phpunit.pgsql.xml
    or (Windows, with pdo_pgsql not enabled globally):
      php -d extension=pdo_pgsql vendor/bin/phpunit -c phpunit.pgsql.xml

    The default phpunit.xml keeps SQLite :memory: for fast local runs.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- No DB_CONNECTION / DB_DATABASE here: the environment selects PostgreSQL. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,127.0.0.1"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
