APP_NAME="Online Mall Cordova"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_FRONTEND_URL=http://localhost:5173
APP_FORCE_HTTPS=false
# Comma-separated allow-list of Host headers. Required to block Host-header
# injection (password-reset link poisoning); set your real domain in production.
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL (https://www.postgresql.org/download/).
# Create:  CREATE ROLE onlinemall LOGIN PASSWORD '...';
#          CREATE DATABASE online_mall OWNER onlinemall;
#          CREATE DATABASE online_mall_test OWNER onlinemall;
# Docker overrides DB_HOST/DB_PORT/DB_PASSWORD via compose.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=online_mall
DB_USERNAME=onlinemall
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
# Bearer-token lifetime in minutes for cross-origin (Vercel -> cPanel) auth; empty = no expiry.
SANCTUM_EXPIRATION=10080

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
# Optional regex allow-list for preview domains (comma separated), e.g. ^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_PATTERNS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@onlinemall.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
