{
  "name": "onlinemall-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "build": "tsc -b && vite build",
    "build:cpanel": "tsc -b && vite build --mode cpanel --outDir dist-cpanel-frontend --emptyOutDir",
    "build:local-split": "tsc -b && vite build --mode cpanellocal --outDir dist-e2e-split --emptyOutDir",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve:static": "node scripts/serve-static.mjs",
    "serve:docker-sim": "node scripts/serve-docker-sim.mjs",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-cpanel.ps1",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:vite": "playwright test --config tests/e2e/playwright.config.ts --project=vite-dev",
    "test:e2e:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-e2e.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
