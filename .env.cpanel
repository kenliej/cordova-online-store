# Frontend build profile: split deployment (Vercel SPA -> cPanel API).
#
# Used by:  npm run build:cpanel
# Output:   dist-cpanel-frontend/
#
# The API is cross-origin, so auth uses Bearer tokens issued by
# POST /api/auth/token (see docs/DEPLOYMENT-CPANEL-VERCEL.md).
VITE_API_BASE_URL=https://kjugarap.top/omc-backend/api
VITE_AUTH_MODE=token
