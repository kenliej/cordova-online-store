# Production environment template for Render + Neon.
# Copy values into Render Dashboard -> Environment (do not commit real secrets).
# Neon values come from `neon deploy` / `.env` in the project root.

APP_NAME="Online Mall Cordova"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_URL=https://YOUR-SERVICE.onrender.com
APP_FRONTEND_URL=https://YOUR-PROJECT.vercel.app
APP_TIMEZONE=Asia/Manila
APP_FORCE_HTTPS=true
LOG_CHANNEL=stderr
LOG_LEVEL=info
TRUSTED_HOSTS=*.onrender.com,localhost
TRUSTED_PROXIES=*

# Neon Postgres (pooled for requests, direct for migrations)
DB_CONNECTION=pgsql
DB_PORT=5432
DB_SSLMODE=require
DATABASE_URL=postgresql://...-pooler...?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://...?sslmode=require
# Optional alternative to DATABASE_URL:
# DB_URL=
# DB_HOST=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
RUN_MIGRATIONS=true

# Vercel SPA uses Bearer tokens (cross-origin), not Sanctum cookies.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
CORS_SUPPORTS_CREDENTIALS=false

# Neon Object Storage (branch-scoped S3 credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_OBJECT_STORAGE_BUCKET=assets

# Neon AI Gateway
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_MODEL=gpt-5-mini

# Neon Realtime
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Email / forgot-password disabled in production (no SMTP configured).
# Mailpit is local-Docker only. Set PASSWORD_RESET_ENABLED=true and add SMTP
# settings only if you intentionally want email-based password resets.
PASSWORD_RESET_ENABLED=false
MAIL_MAILER=log
